# Copy this file to .env and fill in your values for local development.
# On Replit these are injected automatically — you do not need .env there.

# PostgreSQL connection string (required)
# Local example: postgresql://postgres:password@localhost:5432/trading_signals
DATABASE_URL=postgresql://user:password@localhost:5432/trading_signals

# Polygon.io API key (required for live price data)
# Free tier: https://polygon.io — 5 requests/minute
POLYGON_API_KEY=your_polygon_api_key_here

# Session secret — any random string is fine for local dev
SESSION_SECRET=change_me_to_a_random_string

# Ollama (optional — only needed for AI Engine features)
# Defaults to http://localhost:11434 if not set
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b

# Server port — defaults to 5000 if not set
# PORT=5000
