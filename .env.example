# Copy this file to .env and fill in your values.
# The API server and drizzle-kit both load this file automatically —
# you do NOT need to export these variables in your terminal session.

# Required — PostgreSQL connection string.
# Local Windows example (adjust user/password/dbname as needed):
DATABASE_URL=postgresql://postgres:password@localhost:5432/trading_signals

# Required — Polygon.io API key (free tier works for historical bars).
POLYGON_API_KEY=your_polygon_api_key_here

# Required — any random string; used for Express session signing.
SESSION_SECRET=change_me_to_any_random_string

# Optional — Ollama model configuration.
# Primary decision model (default: qwen3:8b)
OLLAMA_MODEL=qwen3:8b
# Fallback model used when primary is unavailable (default: qwen2.5:7b)
OLLAMA_MODEL_FALLBACK=qwen2.5:7b
# Vision model is auto-detected (qwen2.5vl:7b) — no env var needed.
